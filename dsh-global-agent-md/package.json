{
  "name": "dsh-global-agent-md",
  "version": "0.2.0",
  "description": "把程序目录下的全局 AGENT.md 注入 DSH 每一次请求，并在「设置 → 插件 → 全局要求」里提供编辑界面",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-md",
    "instructions"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5-alpha.2"
  }
}
